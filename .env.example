# Control plane (portable - copy this file + ./data to move hosts)
PORT=8080
DATA_DIR=./data
DATABASE_PATH=./data/control.db
CRED_ENC_KEY= # base64 32 bytes, generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=change-me

# GitHub OAuth (MVP - GitHub sign-in only)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback
# Minimal scopes requested: repo codespace read:user

# Oracle user-owned runtime - users supply their own via UI, these are for control-plane host only if needed
# OCI_TENANCY_OCID=
# OCI_REGION=us-ashburn-1

# OpenCode models - only free models listed in docs/free-limits.md are offered by default
OPENCODE_DEFAULT_MODEL=
